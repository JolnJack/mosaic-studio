# Local start: copy this file to .env, npm ci, npm start
PORT=4173
HOST=127.0.0.1
NODE_ENV=development
DATA_DIR=./data
LOCAL_WORKSPACE=1
# Set 0 when public registration should be disabled.
REGISTRATION_ENABLED=1
# Use public DNS-over-HTTPS when local proxy DNS returns benchmarking addresses.
# Production can use system instead; every resulting IP is checked and pinned.
IMPORT_DNS_MODE=doh

# Real generation/editing requires operator credentials and can incur model fees.
# Development tests use loopback fixtures only; no live key is needed for tests.
AI_PROVIDER=anthropic
AI_API_KEY=
ANTHROPIC_API_KEY=
# Leave blank for provider default. compatible defaults to api.openai.com/v1;
# anthropic defaults to api.anthropic.com/v1. Never put secrets in browser code.
AI_BASE_URL=
AI_MODEL=

# Optional Stripe subscription infrastructure. Never expose these client-side.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://127.0.0.1:4173

# Development leaves Stripe keys/prices blank. Use Stripe test credentials only
# for your own later integration test. Real customer billing is configured separately.
# One successful generation or chat revision counts as one monthly AI request.
# These limits are product allowances, not guaranteed provider tokens or cost limits.
AI_FREE_LIMIT=10
AI_PRO_LIMIT=200
AI_STUDIO_LIMIT=600
AI_BUSINESS_LIMIT=1500
PROJECT_FREE_LIMIT=3
PROJECT_PRO_LIMIT=30
PROJECT_STUDIO_LIMIT=100
PROJECT_BUSINESS_LIMIT=200

# Production: NODE_ENV=production, LOCAL_WORKSPACE=0, HOST=0.0.0.0
# behind your TLS reverse proxy; APP_URL=https://app.amadeu.tech
