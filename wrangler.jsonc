{
  "name": "mosaic-studio",
  "main": "worker.mjs",
  "account_id": "9383184e1da31353b270a83941e00817",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": ".worker-assets", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "MOSAIC_DB", "class_name": "MosaicDatabase" }, { "name": "MOSAIC_ADMISSION", "class_name": "MosaicAdmission" }, { "name": "MOSAIC_DIRECTORY", "class_name": "MosaicDirectory" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MosaicDatabase", "MosaicAdmission", "MosaicDirectory"] }],
  "routes": [{ "pattern": "app.amadeu.tech", "custom_domain": true }],
  "vars": {
    "NODE_ENV": "production", "PUBLIC_URL": "https://app.amadeu.tech", "LOCAL_WORKSPACE": "0",
    "REGISTRATION_ENABLED": "1", "AUTH_CONCURRENCY": "1", "AI_PROVIDER": "anthropic", "URL_IMPORT_ENABLED": "0"
  },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 0.1, "invocation_logs": false }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "build": { "command": "node scripts/build-worker-assets.mjs" }
}
