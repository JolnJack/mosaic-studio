{
  "name": "amadeu-mosaic-studio",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "worker:dev": "wrangler dev",
    "worker:check": "wrangler deploy --dry-run",
    "worker:test": "node scripts/smoke-worker.mjs",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "cheerio": "1.2.0"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
